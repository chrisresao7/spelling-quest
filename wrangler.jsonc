// Cloudflare Worker settings. Cloudflare builds the site (npm run build) and deploys it with
// `npx wrangler deploy` on every push to main. See README, "Deploying privately".
{
  "name": "spelling-quest",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the recordings API runs code; everything else is served straight from dist/.
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [{ "binding": "RECORDINGS", "bucket_name": "spelling-quest-recordings" }]
}
